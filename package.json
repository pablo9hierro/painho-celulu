{
  "name": "primeiras-noticias-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Editor de vídeo jornalístico local — Reels, feed, manchetes animadas, timeline e exportação via FFmpeg.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm install && node scripts/check-env.mjs && npm run db:init",
    "check": "node scripts/check-env.mjs",
    "db:init": "tsx server/initDb.ts",
    "dev": "node scripts/check-env.mjs && concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --open",
    "start": "npm run build && node scripts/check-env.mjs && concurrently -k -n server,web -c blue,green \"tsx server/index.ts\" \"vite preview --port 5173 --open\"",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --mode app",
    "android:sync": "npm run build:app && cap sync android",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "autopost": "tsx server/autopost/run.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@fontsource/anton": "^5.2.6",
    "@fontsource/barlow": "^5.2.6",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/source-serif-4": "^5.2.8",
    "express": "^5.1.0",
    "immer": "^10.1.1",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^0.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.53.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
